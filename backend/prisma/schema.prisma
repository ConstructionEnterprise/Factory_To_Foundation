// Factory » Foundation — enterprise migration, Phase 2.
//
// Every model here traces back to a real shape already living in the
// frontend today (see the Phase 1 investigation report, and the ownedBy
// type-safety fix, commit afb5d3e, for OwningModule's real values). Nothing
// here is invented from a generic ERD template — where Phase 1 found a real
// DAG (Genealogy), this uses a real junction table, not a parent_id column;
// where Phase 1 found a derived value (Construction's site precision), this
// deliberately has no column for it at all.
//
// Explicitly OUT of this schema, per Phase 1 section 4 — static reference/
// generated assets, not operational records:
//   northTexasCounties.ts, usaStates.ts, northTexasElevation.ts,
//   the DH kinematics constants, design tokens (--ff-* CSS variables).
// These stay code-level, bundled with the frontend, never migrated to SQL.
//
// No API routes, no auth, no frontend wiring in this phase — schema +
// migrations + seed only.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts, not here — `url` on
// this block was removed/rejected by `prisma validate` (P1012). Real
// current behavior, not a stylistic choice: migrations for driver adapters
// work automatically as of Prisma 7, no further config needed here.
datasource db {
  provider = "postgresql"
}

// ───────────────────────── RBAC ─────────────────────────
// Module, Role, and Permission are real tables with real seeded rows, not
// Postgres enums — per explicit instruction, so the role/module/permission
// list is genuinely queryable data an admin UI (a later phase) could read
// and eventually manage, not logic hardcoded into application code.

model Module {
  /// Real stable slug — the same 11 ids the frontend's own feature routing
  /// already uses (manufacturing, factory, robotics, logistics,
  /// construction, genealogy, scheduling, assets, analytics, reports,
  /// administration).
  id   String @id
  name String

  rolePermissions RolePermission[]
  scheduleStages  ScheduleStage[]
  scheduleTasks   ScheduleTask[]

  @@map("module")
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  users           User[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  /// Real stable slug — read | create | update | delete | execute | administer.
  id   String @id
  name String

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId     String     @map("module_id")
  module       Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, moduleId, permissionId])
  @@map("role_permission")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String   @map("display_name")
  roleId      String   @map("role_id")
  role        Role     @relation(fields: [roleId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  /// Argon2 hash — never the raw password. Real accounts are created via
  /// backend/scripts/create-user.ts (an interactive CLI, masked password
  /// prompt), never seeded in seed.ts — that file is checked into git and
  /// must never carry even a hashed real credential.
  passwordHash String @map("password_hash")

  instructionExecutions      InstructionExecution[]
  refreshTokens              RefreshToken[]
  uploadedFiles              ProjectFile[]           @relation("ProjectFileUploadedBy")
  deletedFiles               ProjectFile[]           @relation("ProjectFileDeletedBy")
  uploadedLogisticsDocuments LogisticsDocument[]     @relation("LogisticsDocumentUploadedBy")
  deletedLogisticsDocuments  LogisticsDocument[]     @relation("LogisticsDocumentDeletedBy")
  logisticsCustodyEvents     LogisticsCustodyEvent[]
  uploadedComplianceDocuments ComplianceDocument[]   @relation("ComplianceDocumentUploadedBy")
  deletedComplianceDocuments  ComplianceDocument[]   @relation("ComplianceDocumentDeletedBy")
  scheduleTaskStatusEvents   ScheduleTaskStatusEvent[]
  preference                 UserPreference?
  mileageRateConfigs         MileageRateConfig[]
  taxReportedLogisticsDispatches LogisticsDispatch[]
  costEstimateScenarios      CostEstimateScenario[]
  marketCostRecords          MarketCostRecord[]
  productivityRecords        ProductivityRecord[]
  costAssemblies             CostAssembly[]
  projectQuantityTakeoffs    ProjectQuantityTakeoff[]
  logisticsFlows             LogisticsFlow[]
  moduleSequenceEvents       ModuleSequenceEvent[]
  flowPointStatusEvents      FlowPointStatusEvent[]
  analyticsThresholds        AnalyticsThreshold[]
  analyticsDashboards        AnalyticsDashboard[]
  schedules                  Schedule[]

  @@map("user")
}

/// Settings panel (A2), Phase 1 of the Ribbon/Networking/Settings build.
/// One real row per user — each of the panel's 5 sections stored as its own
/// nullable JSON blob rather than 20+ individual columns, matching
/// InstructionSet.elementSpecJson's own "a snapshot of real preferences, not
/// a separately-queried entity" precedent. Absent (null) means the user
/// never touched that section yet — the frontend applies its own real
/// defaults in that case, never a fabricated stored default.
model UserPreference {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceJson     Json? @map("workspace_json")
  appearanceJson    Json? @map("appearance_json")
  notificationsJson Json? @map("notifications_json")
  accessibilityJson Json? @map("accessibility_json")
  preferencesJson   Json? @map("preferences_json")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_preference")
}

/// Real, server-side, revocable refresh-token store (Phase 3b) — a JWT
/// alone only self-expires; this table is what makes logout and admin-
/// initiated revocation real rather than "wait for the token to time out."
/// Stores a HASH of the refresh token, never the raw token — same
/// principle as User.passwordHash: a leaked database dump must not itself
/// be a usable credential.
model RefreshToken {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex digest of the real refresh token — the raw token is
  /// never stored, only ever held by the client (httpOnly cookie) and
  /// briefly in memory server-side at issue/verify time.
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at")
  /// Non-null once real rotation (a successful /auth/refresh) or a real
  /// /auth/logout has retired this token — a genuinely revoked token,
  /// never deleted, so a reuse attempt after rotation/logout is a real,
  /// detectable event, not silently indistinguishable from "never existed."
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_token")
}

// ───────────────────── Manufacturing → Factory instructions ─────────────────────
// From context/ManufacturingOutputContext.tsx. Currently in-memory only,
// regenerated on demand — this table is the durable version of that shape.

model InstructionSet {
  id                   String   @id @default(cuid())
  /// Real ingested unit/module object name, or the building root id for a
  /// representative/building-level run.
  sourceObjectId       String   @map("source_object_id")
  generatedAt          DateTime @map("generated_at")
  /// Real measured ElementSpec (dims, orientationKind, extras,
  /// overlappingFeatures) when generated from a real shop-drawing sheet;
  /// absent for a representative/building-level run. Kept as JSON rather
  /// than normalized — it's a snapshot of what a specific generation run
  /// actually measured, not a separately-queried entity.
  elementSpecJson      Json?    @map("element_spec_json")
  /// Real computed statements (e.g. the fixture-table fit check) — never a
  /// severity score or guessed feasibility rating, per the source type's
  /// own doc comment.
  fabricationNotesJson Json?    @map("fabrication_notes_json")

  steps InstructionStep[]

  // Added Phase 1 (Networking/Settings/Analytics build) — lets the new real
  // execution-logging endpoint upsert idempotently by real generation
  // identity instead of minting a fresh row per Execute click on the same
  // generated set.
  @@unique([sourceObjectId, generatedAt])
  @@map("instruction_set")
}

enum InstructionStepStatus {
  planned
  // Real vocabulary today is exactly "planned" (see InstructionStep.status's
  // source doc comment: never "executing"/"complete", which would imply
  // real execution tracking that doesn't exist at the step level yet).
  // Modeled as a real enum, not a free string, so adding a genuine new
  // status later is a deliberate migration, not a silent string change.
}

model InstructionStep {
  id String @id @default(cuid())

  instructionSetId String         @map("instruction_set_id")
  instructionSet   InstructionSet @relation(fields: [instructionSetId], references: [id], onDelete: Cascade)

  sequence Int

  /// Real manifest id from cell_manifest.json (e.g. "robots.A1", "gantry").
  targetSubsystemId String @map("target_subsystem_id")
  /// Real resolve_target()-compatible name — see resolveCommandTarget() in
  /// the source context file for why this can differ from targetSubsystemId.
  realCommandTarget String @map("real_command_target")
  /// Real manifest type: "robot" | "gantry" | "roller" | "tilt" | "atc" | "rail".
  targetType        String @map("target_type")

  /// Illustrative planning text only — never a draft of an executable
  /// command. Always rendered with a "Planning Draft" disclaimer upstream.
  action String

  /// Real ingested geometry object this step operates on; absent for a
  /// building-level representative sequence.
  relatedObjectId String? @map("related_object_id")

  status InstructionStepStatus @default(planned)

  /// ILLUSTRATIVE ONLY — a round per-step-type estimate, not measured. See
  /// the source type's own doc comment.
  estimatedDurationSec Int @map("estimated_duration_sec")

  /// Real dispatchable command(s) in order — absent when no real
  /// command/coordinate is derivable for this step (never a fabricated
  /// placeholder). `codeJson` is a human-readable KRL-style rendering of
  /// this exact same payload, never independently invented text.
  dispatchJson Json? @map("dispatch_json")
  codeJson     Json? @map("code_json")

  /// Real, computed-at-generation-time reachability concern — absent means
  /// no known issue at generation time, not a guarantee (the twin's own
  /// real dispatch check is still the actual backstop).
  reachabilityIssue String? @map("reachability_issue")

  executions InstructionExecution[]

  // Added Phase 1, same reason as InstructionSet's own new @@unique above —
  // lets a real step be upserted by (set, sequence) instead of needing a
  // client-supplied id the frontend never had a reason to mint before now.
  @@unique([instructionSetId, sequence])
  @@map("instruction_step")
}

/// NEW table — Phase 1's identified gap: a real Execute click (Track B,
/// twinExecute.ts) dispatches real commands to the live twin today and
/// returns a result to the caller, but nothing persists it. This is the
/// real audit trail that doesn't exist yet.
model InstructionExecution {
  id String @id @default(cuid())

  instructionStepId String          @map("instruction_step_id")
  instructionStep   InstructionStep @relation(fields: [instructionStepId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  executedAt DateTime @default(now()) @map("executed_at")
  ok         Boolean

  /// Real per-command CommandExecutionResult[] from twinExecute.ts's
  /// StepExecutionResult — command, params, ok, reason per real dispatched
  /// command in this step, in order.
  commandsJson Json @map("commands_json")

  /// Real twin state.json `frame` at the moment of dispatch, when known.
  twinFrameAtDispatch Int? @map("twin_frame_at_dispatch")

  @@map("instruction_execution")
}

// ───────────────────── Factory collision monitor ─────────────────────
// From features/factory/collisionStore.ts. Currently a real, structured
// event log that's 100% in-memory — gone on tab close. This is that log,
// made durable.

model MonitoringSession {
  id        String    @id @default(cuid())
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  events CollisionEvent[]

  @@map("monitoring_session")
}

model CollisionEvent {
  id String @id @default(cuid())

  monitoringSessionId String            @map("monitoring_session_id")
  monitoringSession   MonitoringSession @relation(fields: [monitoringSessionId], references: [id], onDelete: Cascade)

  subsystemA String @map("subsystem_a")
  subsystemB String @map("subsystem_b")

  /// Real sim tick (state.json `frame`) of the first/last observed
  /// intersecting snapshot.
  startFrame Int @map("start_frame")
  endFrame   Int @map("end_frame")

  /// Exact max penetration depth seen across the event's observed
  /// snapshots (m) — real measurement, not estimated.
  maxPenetration Float @map("max_penetration")
  /// How many observed snapshots showed the intersection — the real
  /// measurement resolution of this event.
  samples        Int

  ongoing    Boolean
  /// True while the contact held in every snapshot since monitoring began
  /// — the measurable signature of a by-construction condition (e.g. the
  /// fixture table overhanging the rails), not a hardcoded pair list.
  persistent Boolean

  @@map("collision_event")
}

// ───────────────────── Construction ─────────────────────
// From constructionData.ts + constructionLocations.ts + constructionSiteStore.ts.

model ConstructionProject {
  /// Real fixture id (stonepine, cedarwood, garden-lofts, skyline) — kept
  /// as the real stable natural key the frontend already treats it as,
  /// not a surrogate id.
  id                 String  @id
  title              String
  /// Real citation of where a location came from when one exists (e.g.
  /// "garden_lofts_params_v2.json: PROJECT.LOCATION"); null for the
  /// projects with no real location source anywhere (honest, not guessed).
  realLocationSource String? @map("real_location_source")

  site                ConstructionSite?
  treeNodes           ConstructionTreeNode[]
  files               ProjectFile[]
  logisticsDispatches LogisticsDispatch[]
  costEstimateScenarios CostEstimateScenario[]
  logisticsModules    LogisticsModule[]
  moduleSequenceEntries ModuleSequenceEntry[]
  genealogyNodes      GenealogyNode[]
  schedules           Schedule[]
  quantityTakeoffs    ProjectQuantityTakeoff[]
  logisticsFlows      LogisticsFlow[]

  @@map("construction_project")
}

model ConstructionSite {
  projectId String              @id @map("project_id")
  project   ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Metadata only — never promotes placement precision on its own (no
  /// geocoding, deliberately, matching constructionSiteStore.ts).
  address String?
  coordsX Float?  @map("coords_x")
  coordsZ Float?  @map("coords_z")

  // Deliberately NO precision column. Phase 1 was explicit: resolveSite()
  // derives precision (unlocated/region/address/sited) from whether coords
  // and/or a real fixture region exist — it must stay computed in the
  // application layer, never stored, or it can drift out of sync with the
  // values it's derived from.

  @@map("construction_site")
}

/// Self-referential adjacency list — matches the real varying-depth
/// structure Phase 1 confirmed (Stonepine has no Buildings tier; Cedarwood
/// does; Garden Lofts/Skyline go straight from Project to Floor). A
/// fixed-depth schema would get this wrong.
model ConstructionTreeNode {
  id String @id

  projectId String              @map("project_id")
  project   ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?                @map("parent_id")
  parent   ConstructionTreeNode?  @relation("ConstructionTreeParent", fields: [parentId], references: [id])
  children ConstructionTreeNode[] @relation("ConstructionTreeParent")

  title      String
  /// Real values today: Project | Building | Floor | Floor Plans.
  objectType String @map("object_type")

  /// Present only on nodes that make sense to inspect — null for
  /// navigational-only rows, never a fabricated placeholder.
  progress       String?
  trade          String?
  inspector      String?
  punchListCount String? @map("punch_list_count")

  logisticsModules LogisticsModule[]
  moduleSequenceEntries ModuleSequenceEntry[]
  quantityTakeoffs ProjectQuantityTakeoff[]

  @@map("construction_tree_node")
}

/// Construction Document Management (S3-backed), Phase 2. Real per-project
/// document store — ProjectFile rows only ever reference S3 by key
/// (`s3Key`), never proxy bytes through Postgres. Uploads/downloads go
/// client -> S3 directly via presigned URLs (backend/src/lib/s3.ts); this
/// row is what the backend writes after authenticating + checking
/// construction:create/update/delete, before handing back a presigned URL.
///
/// Storage layout convention (S3 keys):
///   projects/{projectId}/{treeNodeId}/{fileId}/{version}/{originalFilename}
/// category/subcategory below are real queryable metadata only — they
/// deliberately do NOT need to be part of the S3 key, since
/// treeNodeId/fileId/version together already make every object key
/// unique on their own.
///
/// Scaffolding only this phase — no real document data exists yet to
/// migrate, so this ships with an honest empty state per project, same
/// discipline ConstructionSite used at its own equivalent phase.
model ProjectFile {
  id String @id @default(cuid())

  projectId String              @map("project_id")
  project   ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Real ConstructionTreeNode id this file is attached to (a project
  /// root, a building, a floor — whatever node was selected in Browse at
  /// upload time). NOT a foreign key to a Prisma model —
  /// ConstructionTreeNode is a frontend fixture (constructionData.ts),
  /// deliberately still not migrated to real backend reads this phase
  /// (separately scoped). Validated against the real fixture id list at
  /// the API layer instead (Phase 3), not enforced by a DB constraint.
  treeNodeId String @map("tree_node_id")

  /// Which Browse "folder" this file is filed under — Project Documents |
  /// Drawings & Models | Field Documentation | Quality & Safety. A real,
  /// required classification independent of treeNodeId (which building/
  /// floor) — this is which kind of document it is.
  category    String  @map("category")
  /// Real specific document type within category (e.g. "Building Permit",
  /// "RFI") — absent when the category alone is specific enough, never a
  /// fabricated subtype invented to fill the column.
  subcategory String? @map("subcategory")

  /// Stable across all versions of the same logical file — what a
  /// re-upload targets (the app passes the existing fileId when uploading
  /// a new version), not a fresh one each time.
  fileId  String @default(uuid()) @map("file_id")
  version Int    @default(1)

  originalFilename String @map("original_filename")
  /// Real MIME type as reported by the upload, never guessed from
  /// extension alone if the client provides a real one.
  contentType      String @map("content_type")
  /// Real byte size, confirmed server-side against what S3 actually
  /// stored — never trusted from the client alone.
  sizeBytes        Int    @map("size_bytes")

  /// Real S3 object key, following the storage layout convention above —
  /// the only pointer to the actual bytes. Never store bytes in Postgres.
  s3Key String @unique @map("s3_key")

  uploadedById String   @map("uploaded_by_id")
  uploadedBy   User     @relation("ProjectFileUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  /// Soft delete — never a hard row delete. The S3 object for every
  /// version stays in the bucket regardless of this flag; this only hides
  /// the row from real listing queries, so a real recovery/re-upload
  /// scenario never requires touching S3 directly.
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("ProjectFileDeletedBy", fields: [deletedById], references: [id])

  @@unique([fileId, version])
  @@index([projectId, treeNodeId])
  @@map("project_file")
}

// ───────────────────── Cost Estimating ─────────────────────
// Phase 1.2, 2026-08-16 rollout (docs/decisions/
// 2026-08-16-construction-data-map-cost-estimating-plan.md). Deliberately
// the honest floor, not a reverse-derived target-price model -- no real
// unit-cost rate data (labor/material/equipment/regional factors) exists
// anywhere in FF to derive a breakdown from, so this stays a flat,
// user-entered rate/SF scenario with a server-derived total, same
// "never accept a derived number from the client" discipline as
// LogisticsDispatch.miles.

model CostEstimateScenario {
  id String @id @default(cuid())

  projectId String              @map("project_id")
  project   ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name String

  /// Real, entered, never guessed.
  squareFootage Float @map("square_footage")
  /// Real, entered (e.g. 14500 = $145.00/SF) -- integer cents, same
  /// pattern as every other money field in this schema.
  ratePerSquareFootCents Int @map("rate_per_square_foot_cents")

  /// Honest absence, never defaulted -- null means no overhead/markup
  /// was entered for this scenario, not zero.
  overheadPercent Float? @map("overhead_percent")
  markupPercent   Float? @map("markup_percent")

  notes String?

  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Real, optional bottom-up components (2026-08-17, Phase 4.4 audit
  /// finding) -- CostEstimateScenario and ProjectQuantityTakeoff were two
  /// real, working, completely disconnected "project cost" concepts
  /// until this link: this scenario's own flat squareFootage/rate stays
  /// the required, always-present real entry; real linked takeoffs are
  /// an optional, additive bottom-up composition when they exist. A
  /// scenario with zero linked takeoffs (e.g. the existing "Bid A") is
  /// still a fully real, valid, blended-rate scenario -- linking is never
  /// retroactively required, and the total is never silently recomputed
  /// from components here; reconciling/displaying the two remains a
  /// service-layer/UI concern (see docs/decisions/
  /// 2026-08-17-cross-domain-projection-pattern.md and Phase 6).
  quantityTakeoffs ProjectQuantityTakeoff[]

  @@index([projectId])
  @@map("cost_estimate_scenario")
}

// Real market cost reference data (2026-08-17) -- closes the gap the
// comment above this model used to describe ("no real unit-cost rate data
// ... exists anywhere in FF"). One real, dated, sourced price observation
// per row -- never a fabricated number. Deliberately NOT yet consumed by
// CostEstimateScenario's calculation (that's the next real finding to
// chase once enough real records exist to compose an assembly) -- this
// iteration is just "can FF hold one real sourced unit cost at all,"
// which it could not before this model existed.
enum CostCategory {
  material
  labor
  equipment
}

model MarketCostRecord {
  id String @id @default(cuid())

  category CostCategory
  itemName String @map("item_name")
  /// Real manufacturer/publisher product code, when the source states one
  /// -- null when the observation is a blended/labor rate with no SKU.
  sku String?

  /// Free text -- the real unit this price is quoted in varies genuinely
  /// by category (linear_foot, SF, hour, day, EA), same "real variety, no
  /// forced enum" posture as FlowPoint.type.
  unit String
  /// Real, entered, never derived -- integer cents, same convention as
  /// every other money field in this schema.
  unitCostCents Int @map("unit_cost_cents")

  /// Real geographic market the price applies to, e.g. "US" or "North
  /// Texas" -- exactly as stated by the source, never inferred.
  region String?

  /// Real provenance -- required, not optional, since a MarketCostRecord
  /// with no real source is exactly the fabrication this model exists to
  /// prevent.
  sourceName String   @map("source_name")
  sourceUrl  String?  @map("source_url")
  observedAt DateTime @map("observed_at")

  notes String?

  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assemblyComponents CostAssemblyComponent[]

  @@index([category])
  @@map("market_cost_record")
}

// Real assembly recipes (2026-08-17, cost-data acquisition iteration 2) --
// the break iteration 1 predicted: a real sourced unit price alone can't
// answer "what does a SF of real wall cost," because that needs a real
// QUANTITY relationship (how many LF of stud per SF of wall) as well as a
// real PRICE. Quantity relationships are sourced facts too, not invented
// -- e.g. 16in on-center stud spacing is IBC 2308.5.1, not a guess -- so
// each component carries its own real citation, same discipline as
// MarketCostRecord's own provenance fields. estimatedCostPerUnitCents is
// ALWAYS derived from the linked real MarketCostRecord.unitCostCents x
// quantityPerUnit, never stored -- same "never trust/store a derived
// number" discipline as CostEstimateScenario.totalCents.
model CostAssembly {
  id String @id @default(cuid())

  name String
  /// The real unit this assembly's derived cost is expressed per, e.g.
  /// "SF" for a wall assembly -- free text, mirrors MarketCostRecord.unit.
  unit String

  description String?
  /// Real, disclosed assumptions this assembly's quantities depend on
  /// (e.g. an assumed wall height) when no real per-project takeoff
  /// exists yet to supply one -- an honest placeholder, never silently
  /// baked into a component's quantity with no trace.
  assumptionNotes String? @map("assumption_notes")

  components CostAssemblyComponent[]
  quantityTakeoffs ProjectQuantityTakeoff[]

  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cost_assembly")
}

model CostAssemblyComponent {
  id String @id @default(cuid())

  assemblyId String       @map("assembly_id")
  assembly   CostAssembly @relation(fields: [assemblyId], references: [id], onDelete: Cascade)

  marketCostRecordId String           @map("market_cost_record_id")
  marketCostRecord   MarketCostRecord @relation(fields: [marketCostRecordId], references: [id])

  /// Real, entered, never guessed -- how many of MarketCostRecord.unit
  /// this component needs per one CostAssembly.unit (e.g. 0.75 LF of stud
  /// per SF of wall).
  quantityPerUnit Float @map("quantity_per_unit")

  /// Real citation for the QUANTITY specifically (distinct from the
  /// linked MarketCostRecord's own citation for the PRICE) -- e.g. "IBC
  /// 2308.5.1, 16in o.c. max spacing" or "standard practice, assumes 10ft
  /// wall height (see assembly.assumptionNotes)".
  quantitySourceName String  @map("quantity_source_name")
  quantityNotes      String? @map("quantity_notes")

  /// Real, optional traceability link (2026-08-17, iteration 3) -- set
  /// when this component's quantityPerUnit was DERIVED from a real
  /// ProductivityRecord (e.g. a labor component's hours-per-SF, worked
  /// out from a crew's LF-per-day rate) rather than read directly off a
  /// citation like a building code section. Null for components like the
  /// stud/track/sheathing ones, whose quantity IS the citation itself.
  productivityRecordId String?              @map("productivity_record_id")
  productivityRecord   ProductivityRecord? @relation(fields: [productivityRecordId], references: [id])

  @@unique([assemblyId, marketCostRecordId])
  @@map("cost_assembly_component")
}

// Real labor/crew PRODUCTIVITY observations (2026-08-17, iteration 3) --
// deliberately a separate model from MarketCostRecord, not an overloaded
// reuse of it: a productivity rate (how much gets done per hour/day) is a
// genuinely different kind of real-world fact from a price (what a unit
// costs), and conflating them into one "unitCostCents" field would be
// dishonest modeling, not a genuine simplification. `value` is stored
// EXACTLY as the source states it (e.g. 67, in linear_foot_per_crew_day)
// -- any unit conversion (to hours-per-SF, etc.) happens as a documented
// derivation in the CostAssemblyComponent that references this record,
// never pre-baked into this row.
model ProductivityRecord {
  id String @id @default(cuid())

  task String
  /// Real, entered exactly as observed -- never pre-converted.
  value Float
  /// Free text, e.g. "linear_foot_per_crew_day" -- mirrors
  /// MarketCostRecord.unit's "real variety, no forced enum" posture.
  unit String
  /// Real crew size the rate was observed for, when the source states
  /// one -- null when not stated.
  crewSize Int? @map("crew_size")

  /// Real, disclosed limitations on using this observation elsewhere
  /// (e.g. a wall-height mismatch against the assembly that consumes it)
  /// -- the honest alternative to silently forcing an exact match.
  applicabilityNotes String? @map("applicability_notes")

  region String?

  sourceName String   @map("source_name")
  sourceUrl  String?  @map("source_url")
  observedAt DateTime @map("observed_at")

  notes String?

  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assemblyComponents CostAssemblyComponent[]

  @@map("productivity_record")
}

// Real project quantity takeoffs (2026-08-17, cost-data acquisition
// iteration 4) -- the break iteration 3 flagged and deliberately did NOT
// solve: a real $/unit assembly cost still can't become a real project
// dollar figure without a real QUANTITY of that assembly a given project
// actually needs, and confirmed live that FF had genuinely nowhere to
// hold one -- zero dimension/geometry/area fields exist anywhere in this
// schema outside CostEstimateScenario's own whole-building squareFootage
// (itself illustrative, not a takeoff), and Manufacturing's real geometry
// ingestion (blender-bridge) is a single global, non-project-scoped S3
// key with no schema link to any ConstructionProject at all -- so even
// real uploaded geometry can't be structurally attributed to "this is
// Cedarwood's model." This model is the minimal fix: a place for a REAL,
// human-entered, provenance-disclosed quantity (same "real, entered,
// never guessed" posture CostEstimateScenario.squareFootage already
// uses) -- explicitly NOT a derived/calculated number, and NOT
// pre-populated with an invented Cedarwood figure just to complete a
// demo. `methodology` is required specifically so a takeoff always
// discloses HOW the number was obtained (field measurement, drawing
// takeoff, rough order-of-magnitude, etc.) -- an undisclosed methodology
// is exactly the kind of unsourced number this whole cost-data effort
// exists to prevent.
model ProjectQuantityTakeoff {
  id String @id @default(cuid())

  constructionProjectId String              @map("construction_project_id")
  constructionProject   ConstructionProject @relation(fields: [constructionProjectId], references: [id], onDelete: Cascade)

  /// Real, optional building-level scoping -- null means project-wide.
  buildingTreeNodeId String?               @map("building_tree_node_id")
  buildingTreeNode   ConstructionTreeNode? @relation(fields: [buildingTreeNodeId], references: [id])

  assemblyId String       @map("assembly_id")
  assembly   CostAssembly @relation(fields: [assemblyId], references: [id])

  /// Real, optional -- which real CostEstimateScenario (if any) this
  /// takeoff's real bottom-up cost contributes to. Null means this is a
  /// real, standalone project-level quantity not yet tied to a specific
  /// scenario -- a legitimate real state, not an error.
  costEstimateScenarioId String?               @map("cost_estimate_scenario_id")
  costEstimateScenario   CostEstimateScenario? @relation(fields: [costEstimateScenarioId], references: [id])

  /// Real, entered, never derived -- the actual quantity of
  /// assembly.unit this project/building needs.
  quantity Float
  unit     String

  /// Required real disclosure of how this number was obtained -- e.g.
  /// "field_measurement", "drawing_takeoff", "rough_order_of_magnitude".
  /// Free text, not an enum -- real methodologies vary and a forced enum
  /// would just invite picking the closest-sounding option dishonestly.
  methodology String
  sourceNotes String? @map("source_notes")

  enteredById String   @map("entered_by_id")
  enteredBy   User     @relation(fields: [enteredById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("project_quantity_takeoff")
}

// ───────────────────── Modular Sequencing ─────────────────────
// Phase 2.2, 2026-08-16 rollout (docs/decisions/
// 2026-08-16-modular-sequencing-plan.md). A real Construction domain --
// NOT a Logistics or Inventory feature. Anchors on InventoryItem (the
// same domain-neutral shared identity layer Vehicle/Asset/GenealogyNode
// already use), never on LogisticsModule directly -- LogisticsModule is
// real provenance data feeding that identity, not this domain's key.
// The one real coupling to Logistics/Transportation is the handoff
// contract enforced in the service layer: a ModuleSequenceEntry cannot
// be created until its InventoryItem has a real, delivered source
// dispatch (see moduleSequenceService.ts).

enum ModuleSequenceStatus {
  /// Real InventoryItem link exists, but no real delivered dispatch yet
  /// -- this entry's own real state, not Logistics' concern to update.
  pending
  site_arrival
  site_acceptance
  installation
  placement
  complete
}

model ModuleSequenceEntry {
  id String @id @default(cuid())

  /// The real, domain-neutral identity this entry sequences -- not
  /// LogisticsModule directly. See this section's own header comment.
  inventoryItemId String        @unique @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  /// Resolved from the linked LogisticsModule's own real
  /// constructionProjectId/buildingTreeNodeId at entry-creation time, not
  /// re-derived ad hoc -- a real reassignment later gets an explicit
  /// re-sequence, never a silently stale entry.
  constructionProjectId String              @map("construction_project_id")
  constructionProject   ConstructionProject @relation(fields: [constructionProjectId], references: [id])

  buildingTreeNodeId String               @map("building_tree_node_id")
  buildingTreeNode   ConstructionTreeNode @relation(fields: [buildingTreeNodeId], references: [id])

  status ModuleSequenceStatus @default(pending)

  /// Real, user-set installation order -- scoped PER BUILDING (decided
  /// 2026-08-16), unique within (buildingTreeNodeId), not global across
  /// the project. Null = not yet sequenced.
  sequencePosition Int? @map("sequence_position")

  /// Real citation only (§1 of the plan doc) -- the dispatch that
  /// produced this entry's real handoff. Never duplicates dispatch/
  /// truck/driver data; resolved by joining LogisticsDispatch when
  /// displaying, same pattern flowPointResolution.ts already uses.
  sourceDispatchId String? @map("source_dispatch_id")

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  blockingDependencies ModuleSequenceDependency[] @relation("ModuleSequenceDependencyBlocking")
  blockedDependencies  ModuleSequenceDependency[] @relation("ModuleSequenceDependencyBlocked")
  events               ModuleSequenceEvent[]

  @@index([constructionProjectId])
  @@index([buildingTreeNodeId])
  @@map("module_sequence_entry")
}

model ModuleSequenceDependency {
  id String @id @default(cuid())

  /// Real many-to-many blocker graph, same DAG-not-tree reasoning as
  /// GenealogyEdge -- an entry's installation can legitimately depend on
  /// more than one predecessor.
  blockingEntryId String              @map("blocking_entry_id")
  blockingEntry   ModuleSequenceEntry @relation("ModuleSequenceDependencyBlocking", fields: [blockingEntryId], references: [id], onDelete: Cascade)

  blockedEntryId String              @map("blocked_entry_id")
  blockedEntry   ModuleSequenceEntry @relation("ModuleSequenceDependencyBlocked", fields: [blockedEntryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockingEntryId, blockedEntryId])
  @@map("module_sequence_dependency")
}

model ModuleSequenceEvent {
  id String @id @default(cuid())

  sequenceEntryId String              @map("sequence_entry_id")
  sequenceEntry   ModuleSequenceEntry @relation(fields: [sequenceEntryId], references: [id], onDelete: Cascade)

  /// Null only for the entry's own real creation event, same convention
  /// as LogisticsCustodyEvent.fromStatus/ScheduleTaskStatusEvent.fromStatus.
  fromStatus ModuleSequenceStatus? @map("from_status")
  toStatus   ModuleSequenceStatus  @map("to_status")

  changedById String   @map("changed_by_id")
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now()) @map("changed_at")

  notes String?

  /// This table IS the Timeliner's real data source (Phase 2.3) -- zero
  /// rows for an entry that's never transitioned is an honest empty
  /// state, never backfilled with invented history.
  @@index([sequenceEntryId])
  @@map("module_sequence_event")
}

// ───────────────────── Analytics Observability ─────────────────────
// Phase 3, 2026-08-16 rollout (docs/decisions/
// 2026-08-16-analytics-observability-phase3-plan.md). The metric catalog
// itself is a real backend constant (analyticsMetricCatalog.ts), not a
// table -- every metricKey below is validated against that fixed list at
// the service layer, never a free string a client could invent.

enum AlarmComparator {
  greater_than
  less_than
}

/// One real, stored threshold per metric (@@unique), evaluated live on
/// read -- no cron/evaluator, no notification pipeline. See §2.3 of the
/// plan doc for why this is deliberately not a polled/pushed alarm system.
model AnalyticsThreshold {
  id String @id @default(cuid())

  metricKey String @unique @map("metric_key")

  comparator AlarmComparator
  value      Float

  /// The real time window (in minutes) the current-value evaluation
  /// aggregates over -- e.g. "60" means "count/rate over the last hour."
  windowMinutes Int @default(60) @map("window_minutes")

  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("analytics_threshold")
}

enum AnalyticsWidgetType {
  /// A real Recharts time-series graph over one fixed catalog metricKey.
  metric_graph
  /// The existing real merged Events feed (Phase 1.3's EventsWidget),
  /// exposed as a selectable widget type in its own right.
  events_feed
  /// One of the 13 pre-existing real Phase 1 Analytics widgets
  /// (FactoryWidget, ConstructionWidget, etc.), referenced by key rather
  /// than rebuilt -- see summaryWidgetKey below.
  existing_summary
}

/// A real, shared (not per-user-private) saved dashboard -- see §3.3 of
/// the plan doc for why "shared" is the assumed default. createdById is
/// real authorship, not an ownership/visibility gate.
model AnalyticsDashboard {
  id String @id @default(cuid())

  title     String
  /// Exactly one real row has this true -- the real backfilled dashboard
  /// (see backend/scripts/backfill-default-analytics-dashboard.ts)
  /// reproducing today's exact 13-widget layout, so upgrading to Phase 3
  /// causes zero visual regression.
  isDefault Boolean @default(false) @map("is_default")

  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  widgets AnalyticsDashboardWidget[]

  @@map("analytics_dashboard")
}

model AnalyticsDashboardWidget {
  id String @id @default(cuid())

  dashboardId String             @map("dashboard_id")
  dashboard   AnalyticsDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  widgetType AnalyticsWidgetType @map("widget_type")

  /// Required (validated at the service layer) when widgetType =
  /// metric_graph, null otherwise.
  metricKey String? @map("metric_key")
  /// Required (validated at the service layer) when widgetType =
  /// existing_summary -- one of the 13 real Phase 1 widget keys.
  summaryWidgetKey String? @map("summary_widget_key")

  position  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("analytics_dashboard_widget")
}

// ───────────────────── Genealogy ─────────────────────
// From graphData.ts + genealogyRegistry.ts. Real DAG, not a tree — Phase 1
// confirmed Sub-Assembly has 4 real material parents plus its Component
// parent. A junction table is required; a parent_id column would silently
// collapse this.

enum GenealogyTier {
  material
  framing_package
  component
  subassembly
  module
  building
  project
}

model GenealogyNode {
  id    String        @id
  title String
  tier  GenealogyTier
  /// Real QR from the ported make*Qr functions — absent for Module/
  /// Building/Project tiers, where no real thread has built one yet.
  qr    String?

  outgoingEdges GenealogyEdge[] @relation("GenealogyEdgeFrom")
  incomingEdges GenealogyEdge[] @relation("GenealogyEdgeTo")

  /// Real, additive link into Inventory's shared identity layer (Phase 2,
  /// 2026-08-15) -- see InventoryItem's own doc comment. Nullable, never
  /// touches this row's other real data.
  inventoryItemId String?        @unique @map("inventory_item_id")
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  /// Real, additive link to the real construction project a node is
  /// destined for (2026-08-16, small architectural correction -- see
  /// docs/decisions/2026-08-16-construction-data-map-cost-estimating-plan.md
  /// §7 item 1). Optional because genealogy data can real-exist before
  /// it's assigned to a project -- never backfilled/guessed: no real
  /// GenealogyNode<->ConstructionProject linkage data exists today (the
  /// "Project" tier is a bare title string, not a real cross-reference),
  /// so every existing row stays honestly null until a real assignment is
  /// made through whatever real write path eventually sets it.
  constructionProjectId String?             @map("construction_project_id")
  constructionProject   ConstructionProject? @relation(fields: [constructionProjectId], references: [id])

  @@map("genealogy_node")
}

model GenealogyEdge {
  id String @id @default(cuid())

  fromId String        @map("from_id")
  from   GenealogyNode @relation("GenealogyEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String        @map("to_id")
  to     GenealogyNode @relation("GenealogyEdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@map("genealogy_edge")
}

// ───────────────────── Scheduling ─────────────────────
// From scheduleData.ts + the ownedBy type-safety fix (commit afb5d3e).
// OwningModule below has the exact 3 real values that commit defined —
// deliberately narrower than the 11-value Module table above, because the
// real frontend type (OwningModule = 'logistics' | 'factory' |
// 'construction') is itself that narrow. Using the full Module table here
// instead would let this column hold a value the real frontend type could
// never produce (e.g. "genealogy" as a schedule-stage owner).

enum OwningModule {
  logistics
  factory
  construction
}

enum PortDirection {
  input
  output
}

/// Phase 2 (2026-08-16, docs/decisions/
/// 2026-08-16-scheduling-schedule-persistence-phase2-plan.md): real,
/// first-class Schedule entity -- was previously only ever simulated by a
/// title-prefix naming convention (CE Forge's "S1 Material-to-Module" etc,
/// 2026-08-12 boundary experiment). No status field: only add one if a
/// real schedule-level lifecycle (distinct from its tasks' own statuses)
/// is ever identified -- none has been.
model Schedule {
  id          String   @id @default(cuid())
  title       String
  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Real, additive, nullable -- no real evidence today ties a schedule
  /// to a construction project (real S1-S4 titles read like
  /// manufacturing-pipeline schedules), but cheap to add now vs. a
  /// second migration later, same reasoning as LogisticsModule's own
  /// additive project FK.
  constructionProjectId String?              @map("construction_project_id")
  constructionProject   ConstructionProject? @relation(fields: [constructionProjectId], references: [id])

  stages ScheduleStage[]
  tasks  ScheduleTask[]

  @@map("schedule")
}

/// Real, optional reference taxonomy preserving the original 5-stage
/// pipeline concept (Phase 2, same plan doc, §1.3) -- built even though
/// no real schedule's real stages reference it yet (the real CE Forge
/// S1-S4 step names don't match any of these 5). Exists for whenever a
/// schedule's real steps do line up with this pipeline, not because
/// today's data needs it.
model CanonicalStage {
  id          String  @id @default(cuid())
  title       String  @unique
  subtitle    String?
  description String?
  order       Int

  stages ScheduleStage[]

  @@map("canonical_stage")
}

/// Redesigned Phase 2 (2026-08-16): real stages are now schedule-scoped,
/// not five shared global rows -- confirmed live against sandbox that no
/// real ScheduleStage/Port/Wire rows ever existed at all (0/0/0), so
/// there was never a real global taxonomy to preserve structurally, only
/// the frontend fixture's concept of one (see CanonicalStage above).
model ScheduleStage {
  id String @id @default(cuid())

  scheduleId String   @map("schedule_id")
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  title String
  /// Real ordering within its schedule -- didn't exist as a stored
  /// column before (the old 5-stage fixture ordered by array position/x
  /// coordinate, neither of which was real stored data).
  position Int

  /// Optional narrative text -- required on the old global 5-stage rows
  /// (which had real fixture-authored copy for each); nullable here
  /// since a real backfilled stage (e.g. "Kitting," parsed from a real
  /// task title) has no such text and none is fabricated for it.
  subtitle    String?
  description String?

  /// null = genuinely no owning module yet — never a placeholder value
  /// standing in for a real absence (same discipline as before).
  ownedByModuleId String? @map("owned_by_module_id")
  ownedByModule   Module? @relation(fields: [ownedByModuleId], references: [id])

  /// Optional link into the preserved 5-stage taxonomy above. Null for
  /// any stage that isn't one of the 5 canonical pipeline steps (e.g. a
  /// real "Kitting" or "QC Release" stage stays null here).
  canonicalStageId String?         @map("canonical_stage_id")
  canonicalStage   CanonicalStage? @relation(fields: [canonicalStageId], references: [id])

  ports SchedulePort[]
  tasks ScheduleTask[]

  @@index([scheduleId])
  @@map("schedule_stage")
}

model SchedulePort {
  id      String        @id @default(cuid())
  stageId String        @map("stage_id")
  stage   ScheduleStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  /// Real port id string from the source (e.g. "poPlaced") — kept distinct
  /// from the surrogate `id` above because the real frontend only
  /// guarantees this string is unique WITHIN its own stage, not globally.
  portKey   String        @map("port_key")
  label     String
  direction PortDirection
  /// Real vocabulary today is exactly "BOOL" (PortType in scheduleData.ts,
  /// deliberately not a richer type without a real reason yet).
  type      String        @default("BOOL")

  outgoingWires ScheduleWire[] @relation("ScheduleWireFrom")
  incomingWires ScheduleWire[] @relation("ScheduleWireTo")

  @@unique([stageId, portKey])
  @@map("schedule_port")
}

/// One real wire per consecutive real pipeline pair, port-to-port —
/// matches scheduleWires in scheduleData.ts exactly (not a generic
/// node-to-node connector).
model ScheduleWire {
  id         String       @id @default(cuid())
  fromPortId String       @map("from_port_id")
  fromPort   SchedulePort @relation("ScheduleWireFrom", fields: [fromPortId], references: [id], onDelete: Cascade)
  toPortId   String       @map("to_port_id")
  toPort     SchedulePort @relation("ScheduleWireTo", fields: [toPortId], references: [id], onDelete: Cascade)

  @@map("schedule_wire")
}

// ───────────────── Scheduling — real tasks (Phase 1, Networking/Settings/Analytics build) ─────────────────
// ScheduleTask is a real schedulable item with real planned/actual dates,
// optionally filed under a real schedule-scoped stage (Schedule/
// ScheduleStage above, redesigned Phase 2, 2026-08-16) and/or owned by one
// of the real 13 Module rows (reusing ScheduleStage.ownedByModuleId's own
// "null = genuinely no owner yet" discipline, not a placeholder). This is
// what unblocks Delay Impact Simulation, a real Interactive Gantt Timeline,
// Schedule Heat Map, and Critical Path — none of which can honestly exist
// without real task/dependency data to read.

enum ScheduleTaskStatus {
  planned
  in_progress
  complete
  blocked
}

model ScheduleTask {
  id    String @id @default(cuid())
  title String

  /// Real, direct, nullable link to Schedule -- NOT solely inferred
  /// through stageId. The Phase 2 plan doc's own S1-S4 mapping test
  /// found that inference-only-through-stage can't represent the real
  /// data: all 29 real ScheduleTask rows have stageId=null, so schedule
  /// membership needs its own real FK, mirroring stageId's own existing
  /// optionality (a task can be "in a schedule but not yet staged," same
  /// honest-empty shape as "not yet staged" itself).
  scheduleId String?   @map("schedule_id")
  schedule   Schedule? @relation(fields: [scheduleId], references: [id])

  /// Optional — a task can exist before/without being filed under a real
  /// schedule-scoped stage (mirrors ownedByModuleId's own nullable-FK
  /// convention: null is a real state, not a placeholder).
  stageId String?       @map("stage_id")
  stage   ScheduleStage? @relation(fields: [stageId], references: [id])

  /// Reuses the real Module table — same join key `scheduleData.ts`'s
  /// OwningModule union already models on the frontend today.
  ownedByModuleId String? @map("owned_by_module_id")
  ownedByModule   Module? @relation(fields: [ownedByModuleId], references: [id])

  plannedStart DateTime  @map("planned_start")
  plannedEnd   DateTime  @map("planned_end")
  /// Null until real work genuinely starts/finishes — never defaulted to
  /// the planned date. This is what makes a real Heat Map (planned vs.
  /// actual) possible instead of fabricated.
  actualStart  DateTime? @map("actual_start")
  actualEnd    DateTime? @map("actual_end")

  status ScheduleTaskStatus @default(planned)

  predecessorLinks ScheduleTaskDependency[] @relation("DependencySuccessor")
  successorLinks   ScheduleTaskDependency[] @relation("DependencyPredecessor")
  statusEvents     ScheduleTaskStatusEvent[]

  @@index([scheduleId])
  @@index([stageId])
  @@index([ownedByModuleId])
  @@map("schedule_task")
}

/// Real predecessor -> successor edges — a task can have more than one of
/// each (a true dependency DAG, not a single "previous task" pointer), the
/// same "don't collapse a real multi-parent shape" discipline Genealogy's
/// own edge table already established.
model ScheduleTaskDependency {
  id String @id @default(cuid())

  predecessorId String       @map("predecessor_id")
  predecessor   ScheduleTask @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successorId   String       @map("successor_id")
  successor     ScheduleTask @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@map("schedule_task_dependency")
}

/// Real audit trail for a task's status transitions — same atomic
/// status-update-plus-event pattern as LogisticsCustodyEvent, reused
/// directly rather than re-invented.
model ScheduleTaskStatusEvent {
  id     String       @id @default(cuid())
  taskId String       @map("task_id")
  task   ScheduleTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Null only for a task's own real creation event, same convention as
  /// LogisticsCustodyEvent.fromStatus.
  fromStatus ScheduleTaskStatus? @map("from_status")
  toStatus   ScheduleTaskStatus  @map("to_status")

  changedById String   @map("changed_by_id")
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now()) @map("changed_at")

  notes String?

  @@index([taskId])
  @@map("schedule_task_status_event")
}

// ───────────────────── Logistics ─────────────────────
// Phase 4 of the Logistics brief (Factory_To_Foundation/frontend/CLAUDE.md
// §17) — real data model for Material (Storage), Module (Yard), Truck,
// Driver, and Dispatch (Transportation). Zone is expressed by which table a
// row lives in — matching the real LogisticsZone groupings LogisticsBrowse
// already uses (receiving/storage/yard/transportation, confirmed in Phase
// 1) — rather than a duplicated zone column repeated on every row. No
// Receiving model yet; this phase's brief didn't call for one.
//
// Investigated before modeling, per the brief:
// - Dispatch.destination is a REAL FK to ConstructionProject, not free
//   text. Phase 3's corridor cross-nav already resolves a real per-project
//   destination coordinate (constructionLocations.ts's resolveSite()) the
//   exact same way a dispatch's destination needs to; a free-text field
//   would be a regression relative to what Phase 3 already established as
//   real, and would let a dispatch name a destination that doesn't
//   correspond to any real project. Site precision (unlocated/region/
//   sited) still stays computed in the frontend, same as everywhere else —
//   this FK only needs the real project to exist, not a resolved location.
// - LogisticsModule (Yard) gets NO foreign key to any Manufacturing or
//   Scheduling concept. CLAUDE.md gap #12 leaves open whether a
//   Manufacturing "unit" and a Scheduling "module" are even the same
//   concept — forcing a Logistics "module in the yard" onto either would
//   silently answer a question this project has deliberately left open.
//   Kept as its own standalone real table, scoped to Logistics only — same
//   discipline as not forcing ConstructionTreeNode's fixture ids into a
//   real FK before that reconciliation is settled.
// - Module's real lifecycle state (staged in the yard / in transit /
//   delivered) is derived from whether `dispatchId` is set and that
//   dispatch's own `status` — deliberately no separate status column on
//   Module itself, same "derived, never stored" discipline as
//   ConstructionSite's precision. A real status column only exists once,
//   on Dispatch, the record that actually changes state.
// - Dispatch.route ships as a nullable free-text field, not a structured
//   shape — confirmed no real routing/GPS/directions data exists anywhere
//   in this codebase to back one (LogisticsMap's own doc comments are
//   explicit that no real route-a-truck-takes data exists). Same honest-
//   placeholder treatment as Dispatch.traffic — a real non-decision, not
//   an oversight.
//
// Ships as scaffolding only, per the brief: real migration, zero seeded
// rows — same "empty is honest, a fabricated row is not" standard already
// applied to ConstructionSite in Phase 2.

enum LogisticsStatus {
  staged
  in_transit
  delivered
}

model LogisticsMaterial {
  id String @id @default(cuid())

  name     String
  quantity Int?
  /// Real, free-text current location within Storage (e.g. "Bay A") —
  /// metadata only, same non-geocoded-metadata posture as
  /// ConstructionSite.address; no coordinate promotion implied.
  location String?

  /// Real link into Inventory's shared identity layer (Phase 3, 2026-08-17
  /// rollout) -- required as of the follow-up migration; every real
  /// existing row confirmed linked by backfill-material-inventory-items.ts
  /// first (exact-count-asserted), same 2-step discipline as every other
  /// InventoryItem-linkage rollout (Vehicle, LogisticsModule) and as
  /// FlowPoint.flowId (Phase 5).
  inventoryItemId String        @unique @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@map("logistics_material")
}

model LogisticsModule {
  id String @id @default(cuid())

  name     String
  /// Real, free-text current position within the Yard (e.g. "Yard Row 3").
  location String?

  /// Null while staged in the yard with no haul assigned yet — see the
  /// derived-status note above for why Module itself carries no status.
  dispatchId String?            @map("dispatch_id")
  dispatch   LogisticsDispatch? @relation(fields: [dispatchId], references: [id])

  /// Real link into Inventory's shared identity layer (Phase 2.1, Modular
  /// Sequencing rollout, 2026-08-16) -- LogisticsModule is real provenance
  /// data feeding this identity, not the identity itself; see
  /// InventoryItem's own doc comment and
  /// docs/decisions/2026-08-16-modular-sequencing-plan.md §0.2/§0.5.
  inventoryItemId String?        @unique @map("inventory_item_id")
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  /// Real, additive project/building assignment (Phase 2.1, 2026-08-16) --
  /// both nullable: a module can exist staged in the yard, unassigned,
  /// without either. See plan doc §0.3 for why this is a real FK now
  /// rather than derived from dispatch history.
  constructionProjectId String?             @map("construction_project_id")
  constructionProject   ConstructionProject? @relation(fields: [constructionProjectId], references: [id])

  /// Service-layer-asserted to reference a real objectType="Building"
  /// ConstructionTreeNode row -- not enforced by a DB constraint, same
  /// posture as ProjectFile.treeNodeId's own real-but-unenforced link.
  buildingTreeNodeId String?               @map("building_tree_node_id")
  buildingTreeNode   ConstructionTreeNode? @relation(fields: [buildingTreeNodeId], references: [id])

  @@map("logistics_module")
}

model LogisticsTruck {
  id String @id @default(cuid())

  /// Real stable unit/plate identifier (e.g. "TRL-118").
  identifier String @unique

  dispatches LogisticsDispatch[]

  /// Real link to this truck's Fleet/Vehicle identity (Phase 3, 2026-08-15
  /// rollout) -- additive and nullable so every existing real truck row
  /// keeps working unmodified until backfilled (Phase 3.2). Every field
  /// and relation above this line is untouched.
  vehicleId String?  @unique @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("logistics_truck")
}

model LogisticsDriver {
  id   String @id @default(cuid())
  name String

  dispatches LogisticsDispatch[]

  @@map("logistics_driver")
}

model LogisticsDispatch {
  id String @id @default(cuid())

  truckId String         @map("truck_id")
  truck   LogisticsTruck @relation(fields: [truckId], references: [id])

  /// Real generalized Fleet link (Phase 3.3, 2026-08-15 rollout) --
  /// additive and nullable, `truckId` above is untouched and stays
  /// required for every existing real dispatch. Populated from
  /// `truck.vehicleId` for all current (truck-backed) dispatches; exists
  /// so Fleet can resolve a vehicle's dispatch history via one real field
  /// (`vehicleId`) instead of every consumer re-deriving it through
  /// `truck.vehicle`, and so a future non-truck-backed vehicle class
  /// (autonomous dolly, etc.) has a real place to link once one actually
  /// exists -- not built speculatively beyond this additive column.
  vehicleId String?  @map("vehicle_id")
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  driverId String          @map("driver_id")
  driver   LogisticsDriver @relation(fields: [driverId], references: [id])

  /// Real FK to the real destination project — see the investigation note
  /// above for why this isn't free text.
  destinationProjectId String              @map("destination_project_id")
  destinationProject   ConstructionProject @relation(fields: [destinationProjectId], references: [id])

  status LogisticsStatus @default(staged)

  /// Real, free-text current position (e.g. "Route 45, Mile 12") — no real
  /// routing/GPS data exists anywhere to back a structured shape.
  route   String?
  /// Placeholder only — not a live traffic-API integration this pass.
  traffic String?

  /// Added when the real Dispatch-creation form was built (not part of
  /// Phase 4's original schema) — a real, user-entered estimate, never
  /// computed from route/traffic (neither is structured enough to derive
  /// one from). Nullable: honestly absent until someone enters one, not
  /// defaulted to a fabricated time.
  eta DateTime?

  /// Mileage tracking (pilot customer feature, Phase 1). Investigated first:
  /// no real routing graph exists anywhere in this codebase to compute a
  /// real driving distance from — northTexasRoads.ts/PROJECTED_ROADS is a
  /// display-only set of independently named, Douglas-Peucker-simplified
  /// route polylines with no intersection/adjacency topology between them,
  /// and LogisticsDispatch itself has no origin field to route *from*
  /// (only destinationProjectId). A straight-line or county-centroid
  /// distance would not be a real driving mileage figure — presenting it as
  /// one would be fabrication. So this phase captures real, user-entered
  /// odometer readings per haul instead; `miles` is always derived
  /// server-side as odometerEnd - odometerStart (see
  /// logisticsDispatchService.ts's recordMileage()), never accepted as an
  /// independent client-supplied number un-tied to a real reading. Real
  /// route-geometry-based *estimation* (explicitly disclosed as an
  /// estimate, never conflated with an odometer-derived real figure) is a
  /// disclosed future addition, not built this phase.
  odometerStart Float? @map("odometer_start")
  odometerEnd   Float? @map("odometer_end")
  /// Derived, never independently entered — see the note above.
  miles Float?
  /// Required by IRS Publication 463's per-trip recordkeeping standard
  /// alongside date/destination/mileage. Nullable at the schema level
  /// (matching this model's existing honest-absence convention for
  /// route/traffic/eta) — a real export (Phase 2) surfaces a missing value
  /// as genuinely blank, never a fabricated default purpose.
  businessPurpose String? @map("business_purpose")

  /// Real "pushed to tax report" marker (Phase 2 of the pilot mileage-
  /// tracking feature) — set only via pushToTaxReport() once a dispatch is
  /// real-delivered with complete odometer readings and a real business
  /// purpose (see logisticsDispatchService.ts). Nullable/honest-absence:
  /// most dispatches are never pushed. Pushing doesn't freeze the
  /// underlying mileage fields — a correction via recordMileage() afterward
  /// is still possible, same as before push.
  taxReportedAt   DateTime? @map("tax_reported_at")
  taxReportedById String?   @map("tax_reported_by_id")
  taxReportedBy   User?     @relation(fields: [taxReportedById], references: [id])

  dispatchedAt DateTime @default(now()) @map("dispatched_at")

  modules       LogisticsModule[]
  documents     LogisticsDocument[]
  custodyEvents LogisticsCustodyEvent[]

  @@map("logistics_dispatch")
}

/// Real, configurable IRS standard mileage rate (Phase 1 of the pilot
/// mileage-tracking feature) — never hardcoded in application code, since
/// the IRS republishes this annually (and has, in some years, mid-year).
/// Effective-dated rather than a single "current rate" scalar: Publication
/// 463 requires applying the rate that was actually in effect for the
/// period a trip occurred in, not whatever rate happens to be current at
/// export time. A real export (Phase 2) looks up the most recent row whose
/// effectiveDate <= the trip's own dispatchedAt date.
///
/// Deliberately seeded with zero rows (see seed.ts's own "empty is honest"
/// convention for LogisticsMaterial/Module/Truck/Driver/Dispatch) — no
/// specific real-world IRS rate is guessed or fabricated here; a real user
/// enters the real published rate through the API/UI this phase adds.
model MileageRateConfig {
  id String @id @default(cuid())

  /// Real rate in cents per mile (e.g. 67.0 for a $0.67/mi rate). Float,
  /// matching every other numeric field's convention in this schema — no
  /// Decimal type is used anywhere else in this codebase.
  centsPerMile Float @map("cents_per_mile")

  /// The real calendar date this rate took effect.
  effectiveDate DateTime @map("effective_date")

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@map("mileage_rate_config")
}

/// Real chain-of-custody audit trail (Phase 7). Before this, Dispatch had
/// exactly one status column and no way to ever change it (Phase 6's own
/// investigation confirmed only GET/POST existed — no transition route at
/// all) — a single mutable field with no record of who moved a real haul
/// from staged -> in transit -> delivered, or when, is not a chain of
/// custody. This table is the durable log that column was always missing;
/// the status TRANSITION route (see logisticsDispatchService.ts's
/// transitionStatus()) writes exactly one of these per real change, in the
/// same transaction as the status update itself, so the two can never
/// drift apart.
///
/// One real row per real transition — including a real row for a
/// dispatch's own creation (fromStatus null, toStatus staged), so a
/// dispatch's full custody history is always readable from this table
/// alone, never "everything except the first event."
model LogisticsCustodyEvent {
  id String @id @default(cuid())

  dispatchId String            @map("dispatch_id")
  dispatch   LogisticsDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  /// Null only for the one real creation event — every subsequent real
  /// transition has a real prior status to record moving away from.
  fromStatus LogisticsStatus? @map("from_status")
  toStatus   LogisticsStatus  @map("to_status")

  changedById String   @map("changed_by_id")
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now()) @map("changed_at")

  /// Real, optional free-text note (e.g. a reason for an unusual
  /// transition) — never required, never fabricated when absent.
  notes String?

  @@index([dispatchId])
  @@map("logistics_custody_event")
}

/// Logistics Document Management (S3-backed), Phase 5. Scoped to
/// LogisticsDispatch specifically, not to Material/Module/Truck/Driver —
/// investigated before modeling: unlike Construction (one real project +
/// tree-node hierarchy every document naturally files under), Logistics'
/// Phase 4 model has 5 separate real entities with no shared hierarchy.
/// Real-world logistics document types (bill of lading, delivery manifest,
/// proof of delivery) are overwhelmingly per-HAUL documents, not per-truck
/// or per-driver (registration/license paperwork belongs to a real fleet-
/// compliance system, out of scope here and never asked for) — Dispatch is
/// also the one Phase 4 entity that already ties truck+driver+destination
/// together, the closest real analog to ConstructionProject's role as the
/// thing every document is filed under. Scoping to any other entity, or to
/// all five, was never asked for and would be unrequested complexity —
/// this is an explicit, disclosed choice, not an oversight.
///
/// Otherwise mirrors ProjectFile's real shape exactly: S3-key-only rows
/// (never proxy bytes through Postgres), a stable `fileId` versioned
/// separately from the surrogate `id`, soft delete only. No treeNodeId
/// equivalent — Dispatch has no real sub-hierarchy to file under.
///
/// `category` is drawn from a real, closed, industry-standard logistics
/// document vocabulary (see LOGISTICS_DOCUMENT_CATEGORIES in
/// logisticsDocumentService.ts) — NOT quoted from this feature's own task
/// brief the way ProjectFileCategory's four values were quoted from
/// Construction's brief verbatim, since this brief didn't enumerate one.
/// Flagged here so that difference in provenance stays honest, not
/// silently presented the same way.
///
/// Scaffolding only this phase — no real document data exists yet to
/// migrate, so this ships with an honest empty state, same discipline
/// ConstructionSite/ProjectFile used at their own equivalent phase.
model LogisticsDocument {
  id String @id @default(cuid())

  dispatchId String            @map("dispatch_id")
  dispatch   LogisticsDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  category    String  @map("category")
  subcategory String? @map("subcategory")

  /// Stable across all versions of the same logical file — matches
  /// ProjectFile.fileId's own role exactly.
  fileId  String @default(uuid()) @map("file_id")
  version Int    @default(1)

  originalFilename String @map("original_filename")
  contentType      String @map("content_type")
  sizeBytes        Int    @map("size_bytes")

  /// Real S3 object key — logistics-dispatches/{dispatchId}/{fileId}/{version}/{originalFilename},
  /// the same "real key, never proxied bytes" convention as ProjectFile.
  s3Key String @unique @map("s3_key")

  uploadedById String   @map("uploaded_by_id")
  uploadedBy   User     @relation("LogisticsDocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("LogisticsDocumentDeletedBy", fields: [deletedById], references: [id])

  @@unique([fileId, version])
  @@index([dispatchId])
  @@map("logistics_document")
}

// ───────────────────── Compliance & Records (Phase 1, Administration/Networking build) ─────────────────────
// A standalone S3-backed document model, deliberately NOT FK'd to
// ConstructionProject or LogisticsDispatch — OSHA docs/certifications/
// licenses are company/employee-wide records, not per-project or per-haul
// documents the way Document Templates (RFIs/Submittals/Change Orders) are.
// User-confirmed decision, not a default: forcing this onto ProjectFile or
// LogisticsDocument would misrepresent it as belonging to a project/dispatch
// it has no real relationship to. Mirrors ProjectFile's/LogisticsDocument's
// real shape otherwise (S3-key-only rows, stable fileId versioned
// separately from the surrogate id, soft delete only) — only the
// attachment target differs, not the storage discipline.

model ComplianceDocument {
  id String @id @default(cuid())

  /// Real, closed vocabulary in code (OSHA / Certification / License), not
  /// a DB enum — same "closed vocab lives in the service layer" convention
  /// as ProjectFileCategory/LogisticsDocumentCategory.
  category String @map("category")
  /// Free text — who/what this document is about (an employee name, an
  /// equipment id, a site) — deliberately not a real FK to any employee/
  /// equipment table, since neither exists yet (see gap B7).
  subject     String? @map("subject")
  subcategory String? @map("subcategory")

  fileId  String @default(uuid()) @map("file_id")
  version Int    @default(1)

  originalFilename String @map("original_filename")
  contentType      String @map("content_type")
  sizeBytes        Int    @map("size_bytes")

  /// Real S3 object key — compliance-documents/{fileId}/{version}/{originalFilename}.
  s3Key String @unique @map("s3_key")

  uploadedById String   @map("uploaded_by_id")
  uploadedBy   User     @relation("ComplianceDocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")
  deletedBy   User?     @relation("ComplianceDocumentDeletedBy", fields: [deletedById], references: [id])

  @@unique([fileId, version])
  @@map("compliance_document")
}

// ───────────────────── Networking (real IT/OT infrastructure) ─────────────────────
// Built from the real Cisco Packet Tracer diagram CE_Factory_Production_LAN
// (read directly, a screenshot, not a parseable .pkt file) — see the
// Permissions-migration/Networking-module report for the full investigation.
// This is a genuinely different concept from the `networking` RBAC module
// id that existed before this migration: that module was always the real
// Roles & Permissions/User Management RBAC subsystem wearing the wrong
// name — renamed to `permissions` in this same migration, freeing the
// `networking` module id to mean networking for the first time.
//
// Scope, explicit and narrow, per the brief: static device inventory + VLAN
// topology as real seeded data, read-only visualization. No live SNMP/
// telemetry polling, no switch monitoring, no firewall management, no PLC
// communications — all future work, not built here.
//
// Real, disclosed limitation: Packet Tracer's own topology-summary panel in
// the diagram totals 31 devices (by its internal category counts); only 29
// devices could be directly confirmed by name/IP from the screenshot at
// this resolution. Seeded here are the 29 confirmed devices — the 2-device
// gap is disclosed in the frontend UI, not silently forced to reconcile
// (same posture as Manufacturing's own disclosed 272-vs-340 unit
// discrepancy, CLAUDE.md gap #11).
//
// Real, disclosed inference: the diagram confirms 3 real access switches
// each trunking multiple VLANs via 802.1Q, but the exact per-switch VLAN
// assignment wasn't legible at this screenshot's resolution. Endpoints are
// grouped 3 VLANs per access switch (10/20/30 → A, 40/50/60 → B, 70/80/90 →
// C) as a reasonable, disclosed assumption — every device name/IP/VLAN/
// subnet is real; this specific grouping is inferred, not read directly.

enum NetworkDeviceRole {
  firewall
  core_switch
  distribution_switch
  access_switch
  server
  workstation
  plc
  remote_io
  robot_controller
  hmi
  vision_system
  quality_station
  scanner
  shipping_pc
  access_point
  tablet
  laptop
  camera
  door_controller
  card_reader
  supervisor_pc
  printer
}

model NetworkVlan {
  id     String @id @default(cuid())
  /// Real VLAN number from the diagram (e.g. 10, 20 ... 90).
  number Int    @unique
  name   String
  /// Real /24 subnet, e.g. "10.10.10.0/24".
  subnet String

  devices NetworkDevice[]

  @@map("network_vlan")
}

model NetworkDevice {
  id    String            @id @default(cuid())
  /// Real label from the diagram, e.g. "PLC-01", "Core L3 Switch".
  name  String
  role  NetworkDeviceRole
  /// Real hardware model where the diagram shows one (e.g. "3560-24PS",
  /// "2960-X-24PS", "5506-X") — null for devices with no model shown.
  model String?
  /// Real IP from the diagram — null for devices with none shown (e.g. the
  /// Industrial AP).
  ipAddress String? @map("ip_address")

  vlanId String?      @map("vlan_id")
  vlan   NetworkVlan? @relation(fields: [vlanId], references: [id])

  /// Real parent in the topology tree — the diagram's topology is a real
  /// tree (no redundant/mesh links anywhere in it), so a self-referencing
  /// parent pointer is sufficient and simpler than a separate edge table.
  /// Null only for the Edge Firewall, the real root.
  uplinkDeviceId  String?         @map("uplink_device_id")
  uplinkDevice    NetworkDevice?  @relation("NetworkDeviceUplink", fields: [uplinkDeviceId], references: [id])
  downlinkDevices NetworkDevice[] @relation("NetworkDeviceUplink")

  @@index([vlanId])
  @@index([uplinkDeviceId])
  @@map("network_device")
}

// ───────────────────── Assets ─────────────────────
// Closes a real gap, not a new invention: RBAC's own MODULES list already
// seeds a real "assets" module with real per-role permission grants
// (backend/prisma/seed.ts) -- this model and its routes are what was
// missing underneath a module that already existed. Field set mirrors the
// frontend's own assetsData.ts fixture exactly (30 real Codex-generated
// asset definitions, 2026-08-12) -- every field there has a home here,
// nothing invented, nothing dropped.
enum AssetStatus {
  active
  maintenance
  retired
}

enum AssetCategory {
  Vehicles
  Equipment
  Tools
  Infrastructure
}

model Asset {
  id String @id @default(cuid())

  title    String
  subtitle String
  category AssetCategory
  family   String
  status   AssetStatus

  manufacturer String
  model        String
  /// Real unique hardware identifier -- matches the fixture's own
  /// per-asset uniqueness (never two rows share one).
  serialNumber String @unique @map("serial_number")
  /// Real unique CE-internal tag (e.g. "CE-VEH-001") -- same uniqueness
  /// discipline as serialNumber, distinct namespace.
  assetTag     String @unique @map("asset_tag")

  location        String
  acquisitionDate DateTime  @map("acquisition_date")
  lastService     DateTime  @map("last_service")
  /// Null is the real, honest state for a retired asset with no next
  /// service scheduled -- the fixture's "N/A" becomes real null here,
  /// never a placeholder string (same discipline as
  /// ScheduleStage.ownedByModuleId, ScheduleTask.actualStart, etc.).
  nextService     DateTime? @map("next_service")

  notes String?

  /// Real, additive link into Inventory's shared identity layer (Phase 2,
  /// 2026-08-15) -- nullable so this migration never touches an existing
  /// row's other data; backfilled for real rows separately, never inferred.
  inventoryItemId String?        @unique @map("inventory_item_id")
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  @@map("asset")
}

// ───────────────────── Inventory ─────────────────────
// Real shared identity layer (Phase 2 of the 2026-08-15 Inventory/Fleet/
// Analytics/Reports rollout) -- Inventory's canonical cross-domain object
// list. Deliberately NOT a data migration: Asset and GenealogyNode keep
// every field they already have, unmoved. Each real row gets a real,
// additive FK link to one new InventoryItem row instead, giving Inventory
// a single real place to list/search "every object" across both domains
// without duplicating or relocating anything real. `kind` is a
// discriminator so a generic InventoryItem list can resolve to the right
// detail (Asset fields, or Genealogy tier/qr) without a second lookup.
enum InventoryItemKind {
  asset
  genealogy_node
  vehicle
  /// Phase 2.1, 2026-08-16 rollout (Modular Sequencing's real handoff
  /// identity -- see docs/decisions/2026-08-16-modular-sequencing-plan.md
  /// §0.2/§0.5). InventoryItem is the domain-neutral layer Sequencing
  /// anchors on instead of LogisticsModule directly.
  logistics_module
  /// Phase 3, 2026-08-17 (Inventory Command Ribbon rollout). Real gap
  /// found by audit: LogisticsMaterial was the one real Inventory-adjacent
  /// object type NOT wired into this shared identity layer -- every other
  /// kind here already was. Added so Materials can become a genuine peer
  /// Inventory capability to Asset/Genealogy, not just a Logistics-owned
  /// list surfaced elsewhere.
  material
}

model InventoryItem {
  id String @id @default(cuid())

  title    String
  kind     InventoryItemKind
  /// Real, free-text current location -- mirrors Asset.location's own
  /// non-geocoded-metadata posture; null for kinds (genealogy_node) with
  /// no real location concept.
  location String?

  asset          Asset?
  genealogyNode  GenealogyNode?
  vehicle        Vehicle?
  logisticsModule LogisticsModule?
  moduleSequenceEntry ModuleSequenceEntry?
  material       LogisticsMaterial?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("inventory_item")
}

// ───────────────────── Fleet ─────────────────────
// Real Fleet vehicle identity (Phase 3, 2026-08-15 rollout) — the parent
// vehicle class the Manus review proposed, built the same way Assets and
// Genealogy became Inventory capabilities: a real, additive identity
// layer, never a rename/migration of the existing real LogisticsTruck
// data. `LogisticsTruck` keeps every field and every real dispatch
// relation it already has, unmoved -- it gets one new, nullable link to
// its own real Vehicle row instead. `vehicleClass` is the discriminator
// Fleet needs (truck / autonomous dolly / trailer / forklift) that
// LogisticsTruck alone never had a way to express, since it only ever
// modeled trucks.
enum VehicleClass {
  truck
  autonomous_dolly
  trailer
  forklift
}

enum VehicleStatus {
  active
  maintenance
  retired
}

model Vehicle {
  id String @id @default(cuid())

  /// Real stable identifier -- for `truck`-class vehicles this mirrors the
  /// linked LogisticsTruck.identifier (kept in sync at creation, not a
  /// second source of truth invented independently of it).
  identifier   String        @unique
  vehicleClass VehicleClass  @map("vehicle_class")
  status       VehicleStatus @default(active)
  /// Real, free-text current location -- same non-geocoded-metadata
  /// posture as Asset.location/InventoryItem.location.
  location     String?

  /// Real link into Inventory's shared identity layer -- Vehicles are one
  /// of Inventory's real object types alongside Assets and Genealogy
  /// objects (see InventoryItem's own doc comment).
  inventoryItemId String?        @unique @map("inventory_item_id")
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])

  /// Real link to the existing LogisticsTruck row, for `truck`-class
  /// vehicles only -- null for classes (autonomous_dolly, trailer,
  /// forklift) with no real backing table of their own yet. Preserves
  /// every existing real LogisticsDispatch relationship untouched; Fleet
  /// reads truck-specific detail (identifier, dispatch history) through
  /// this link rather than duplicating it.
  logisticsTruck LogisticsTruck?

  /// Real generalized dispatch history (Phase 3.3) -- populated via
  /// LogisticsDispatch.vehicleId, see that field's doc comment.
  dispatches LogisticsDispatch[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("vehicle")
}

// ───────────────────── Synthetic Data Provenance ─────────────────────
// Universal, source-agnostic tag: "this record was generated, not real."
// Deliberately a single side table referenced by (recordType, recordId)
// rather than a column added to every domain model — CE Forge (and any
// future synthetic-data source) gains new domains constantly, and this
// table's whole point is that a new domain never needs its own migration
// just to become provenance-capable. Cost of that choice, accepted
// deliberately: recordId is NOT a real FK (Prisma can't express a
// polymorphic relation across many unrelated tables) -- integrity here is
// an application-layer concern (the CE Forge -> FF write path), not a
// database one. Never read by, or exposed through, any normal FF
// domain route/DTO -- this is metadata beside the data, not part of it.
enum SyntheticDataSource {
  CE_FORGE
}

/// Only meaningful for provenance rows tagging a record with actual binary
/// content elsewhere (e.g. ProjectFile's S3 object) -- most tagged records
/// (ScheduleTask, LogisticsDispatch, ...) have no content to have a status
/// about, hence nullable, not required, on the row itself.
/// RECOVERED = original bytes found and verified.
/// RECONSTRUCTED = new bytes generated from the record's own authoritative
/// metadata, honestly not a claim of matching the lost original.
/// GENERATED = content created together with the record from the start,
/// never claimed to be anything else.
enum SyntheticDataContentStatus {
  RECOVERED
  RECONSTRUCTED
  GENERATED
}

model SyntheticDataProvenance {
  id String @id @default(cuid())

  source SyntheticDataSource

  contentStatus      SyntheticDataContentStatus? @map("content_status")
  /// When the content (not necessarily the record itself) was produced --
  /// distinct from generatedAt, which is about the record.
  contentGeneratedAt DateTime?                    @map("content_generated_at")
  /// Free-text description of what produced the content (e.g. "CE Forge
  /// reconstruction pass (backend/scripts/reconstruct-construction-content.ts)")
  /// -- not an enum, since this is meant to be human-readable provenance,
  /// not a closed vocabulary.
  contentGenerator   String?                      @map("content_generator")

  /// A named body of synthetic data this record belongs to (e.g. one pilot
  /// customer's dataset) -- distinct from runId: one dataset can be built
  /// up across many separate generator runs over time.
  datasetId String @map("dataset_id")
  /// One real invocation of one generator -- the unit "undo everything
  /// this run created" operates on.
  runId     String @map("run_id")
  /// CE Forge's own domain name (e.g. "logistics", "scheduling") -- kept
  /// as a plain string, not an FK to anything FF-side and not an enum,
  /// for the same reason recordId has no FK: CE Forge's domain list is
  /// this project's own evolving taxonomy, not FF's.
  domain    String

  /// Real Prisma model name (e.g. "ScheduleTask", "LogisticsDispatch").
  recordType String @map("record_type")
  /// The real id of the tagged row in its own table.
  recordId   String @map("record_id")

  /// When the generator produced this record (may predate this row's own
  /// creation -- e.g. a batch written to a log before being posted).
  generatedAt DateTime @map("generated_at")
  /// When this provenance row itself was written -- real audit distinction
  /// from generatedAt, same convention as ScheduleTaskStatusEvent.changedAt
  /// vs. the status transition it records.
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([runId])
  @@index([datasetId])
  @@index([recordType, recordId])
  @@map("synthetic_data_provenance")
}

/// Logistics Flow (Point-to-Point) Map -- a real, minimal relationship
/// model for point-to-point movement (Material Point -> Process Point ->
/// Buffer/Staging -> Assembly Cell -> Finished Module -> Outbound today;
/// expected to grow to cover autonomous dolly movement, staging, and yard
/// flow without a schema change, since FlowPoint.type/FlowConnection
/// .relationship are both open, not enums). A real peer of
/// LogisticsDispatch/Module/Material above, not a separate domain --
/// those model outbound trucking to a real Construction project, this
/// models point-to-point movement relationships generally. Domain
/// correction (2026-08-14): this model was originally placed under
/// Manufacturing; on review the model itself was confirmed domain-neutral
/// and moved here, with no schema change. This feature owns relationships
/// only -- it never duplicates another domain's own data, only references
/// it by id via assetRef (an Engineering Asset Catalog id, a Manufacturing
/// model node id, a dolly, a yard/staging capability, etc., owned and
/// defined elsewhere).
// Real project scoping for Logistics Flow (2026-08-17, Phase 4.1) -- the
// Phase 4 project-population audit found FlowPoint/FlowConnection had no
// real FK to ConstructionProject at all, so "which project does this flow
// serve" was structurally unanswerable, only inferable from node-name
// text. A LogisticsFlow is a real, project-scoped operational flow
// INSTANCE (an occurrence of "material moving through Receiving ->
// Storage -> Shop -> Yard -> Transportation Handoff for project X");
// FlowPoint/FlowConnection remain the reusable topology beneath it, now
// grouped under one. Explicitly NOT the same design choice as
// CostAssembly (Phase 4 decision, 2026-08-17): a CostAssembly is reusable
// reference intelligence with no project of its own, while a Logistics
// Flow genuinely is a project-specific operational instance, not shared
// reference data -- these are different real relationships, not the same
// pattern applied twice.
model LogisticsFlow {
  id String @id @default(cuid())

  name String

  constructionProjectId String              @map("construction_project_id")
  constructionProject   ConstructionProject @relation(fields: [constructionProjectId], references: [id])

  points FlowPoint[]

  createdById String   @map("created_by_id")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("logistics_flow")
}

model FlowPoint {
  id String @id @default(cuid())

  /// Required as of the follow-up migration (2026-08-17) -- every real
  /// existing row confirmed linked by backfill-logistics-flow.ts first
  /// (exact-count-asserted), so this is safely tightened from the initial
  /// nullable add, same two-step discipline as every other real backfill
  /// this project has done.
  flowId String        @map("flow_id")
  flow   LogisticsFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  /// Free-text, not a Postgres enum -- deliberately extensible taxonomy.
  /// Suggested vocabulary (documented/offered in the frontend form, not
  /// enforced here): material, process, buffer, staging, assembly,
  /// finished_product, outbound.
  type String

  name String

  /// Layout position on this map's own 2D plane -- not a real-world
  /// geographic coordinate, unlike ConstructionMap's/LogisticsMap's own
  /// real lon/lat-derived positions.
  positionX Float @map("position_x")
  positionY Float @map("position_y")

  /// Generic pointer to a real asset owned elsewhere (an Engineering Asset
  /// Catalog id, a Manufacturing model node id, a dolly, a yard/staging
  /// capability, etc.) -- this table never duplicates that asset's own
  /// geometry/engineering/behavior data.
  assetRef String? @map("asset_ref")

  /// Real operational status (Phase 5, 2026-08-17) -- was free-text and
  /// unused (confirmed live: 0 of 21 real rows had a non-null value before
  /// this migration, so no data-preserving backfill was needed, only a
  /// straight type change). Current status is a real, derived-or-recorded
  /// fact, not a UI label: for `load_assignment`/`transportation_handoff`
  /// points (which already carry a real `assetRef` into Vehicle/
  /// LogisticsDispatch), it's synced from that linked row's own real
  /// status; for every other point type, it only changes via an explicit
  /// human PATCH with a required reason. Every real transition is logged
  /// in FlowPointStatusEvent below -- this column is always the *current*
  /// value, the event table is the history, same split as
  /// LogisticsDispatch.status/LogisticsCustodyEvent and
  /// ModuleSequenceEntry.status/ModuleSequenceEvent.
  status FlowPointStatus @default(normal)
  notes  String?

  outgoingConnections FlowConnection[] @relation("FlowConnectionSource")
  incomingConnections FlowConnection[] @relation("FlowConnectionTarget")

  statusEvents FlowPointStatusEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("flow_point")
}

enum FlowPointStatus {
  normal
  held
  halted
}

/// Real, immutable operational-status history for one FlowPoint (Phase 5,
/// 2026-08-17) -- same shape as LogisticsCustodyEvent/ModuleSequenceEvent,
/// now the fourth real consumer of that "{fromStatus,toStatus,changedAt}"
/// pattern (also read by frontend/src/lib/eventTimeline.ts). Never
/// deleted or edited once written, even by a "Reset" action in the UI --
/// Reset only clears transient client-side view state, never this table.
/// `changedById` is a real user for a manual hold/halt/release; the one
/// real system-attributed case (derived-status sync off a linked
/// Vehicle/LogisticsDispatch) still requires a real actor id -- see
/// flowPointStatusService.ts for which real account is used and why.
model FlowPointStatusEvent {
  id String @id @default(cuid())

  flowPointId String    @map("flow_point_id")
  flowPoint   FlowPoint @relation(fields: [flowPointId], references: [id], onDelete: Cascade)

  /// Null only for the one real creation event.
  fromStatus FlowPointStatus? @map("from_status")
  toStatus   FlowPointStatus  @map("to_status")

  /// Required for held/halted (the operational reason a person or the
  /// derived-status sync recorded); optional when returning to normal.
  reason String?

  changedById String   @map("changed_by_id")
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now()) @map("changed_at")

  @@index([flowPointId])
  @@map("flow_point_status_event")
}

/// A real, directed relationship between two FlowPoints -- direction is
/// inherent in source -> target, not a separate field.
model FlowConnection {
  id String @id @default(cuid())

  sourcePointId String    @map("source_point_id")
  sourcePoint   FlowPoint @relation("FlowConnectionSource", fields: [sourcePointId], references: [id], onDelete: Cascade)

  targetPointId String    @map("target_point_id")
  targetPoint   FlowPoint @relation("FlowConnectionTarget", fields: [targetPointId], references: [id], onDelete: Cascade)

  /// Free-text relationship label (e.g. "material-transfer") -- same
  /// extensible-not-enumerated posture as FlowPoint.type.
  relationship String?

  distanceMeters Float?  @map("distance_meters")
  notes          String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sourcePointId])
  @@index([targetPointId])
  @@map("flow_connection")
}
