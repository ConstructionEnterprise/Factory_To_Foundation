# Local dev defaults only — matches docker-compose.yml's Postgres service.
# Not a real secret; safe to commit as .env.example. Copy to .env (gitignored)
# to actually use it: `cp .env.example .env` (or copy by hand on Windows).
DATABASE_URL="postgresql://ff:ff_dev_local_only@localhost:5432/ff_dev?schema=public"

# Local-dev-only default — real deployments must generate their own real
# random secret (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# and never share it across environments or commit the real value.
JWT_SECRET="dev-only-change-me-194ea0a8e33d9438d9f8e77eb34006885f1e5c824e664285bb1363bc94f79cce"
