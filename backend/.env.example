# Local dev defaults only — matches docker-compose.yml's Postgres service.
# Not a real secret; safe to commit as .env.example. Copy to .env (gitignored)
# to actually use it: `cp .env.example .env` (or copy by hand on Windows).
DATABASE_URL="postgresql://ff:ff_dev_local_only@localhost:5432/ff_dev?schema=public"

# Local-dev-only default — real deployments must generate their own real
# random secret (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# and never share it across environments or commit the real value.
JWT_SECRET="dev-only-change-me-194ea0a8e33d9438d9f8e77eb34006885f1e5c824e664285bb1363bc94f79cce"

# CORS origin this backend allows — defaults to local dev if unset.
ALLOWED_ORIGIN=http://localhost:5173

# Where GET /system/ready calls Factory Runtime's GET /twin-control/live
# (this var name is kept as-is post-migration — same shape, new owner, see
# FACTORY-RUNTIME-MIGRATION-PLAN.md §9 decision #4/#6) — defaults to local
# dev if unset. Real deployments (ff-app-host) should set this to wherever
# Factory Runtime actually listens.
TWIN_BRIDGE_URL=http://localhost:4103

# Real AWS credentials go here too (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_REGION, S3_BUCKET_NAME) — omitted from this example file since no
# placeholder value is meaningful for them. See backend/.env's own comment
# on these: Phase 4 should replace them with an IAM role on compute.

# Self-reported environment identity, surfaced on GET /system/ready as
# "environment" — added after the 2026-08-11/12 shared-dev/prod-database
# incident (CE_Forge/ENVIRONMENT.md). Set to exactly "production" or
# "development"; unset reports "unknown" rather than guessing either way.
# Every real deployment (ff-app-host, ff-backend-asg, and any local process
# pointed at either RDS instance) should set this explicitly.
FF_TARGET_ENV=development
