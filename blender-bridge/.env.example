# Same real S3 bucket backend/.env.example's real .env points at — this
# service needs its own copy of these credentials because it's a separate
# process (and, from Phase 4 on, a separate deployable). Copy to .env
# (gitignored) and fill in the real values: `cp .env.example .env`.
#
# Phase 4 note: these should become an IAM role attached to compute
# instead of static keys once this service is actually containerized —
# not done yet, flagged the same way as backend/.env's own copy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET_NAME=

# CORS origin this bridge allows — matches the frontend dev server.
ALLOWED_ORIGIN=http://localhost:5173

# Real auth (Responsive UI milestone) — must be the exact same real value
# as backend/.env's own JWT_SECRET, so this bridge can verify the same
# session cookie the backend issues. BACKEND_URL is where this bridge asks
# for the real /auth/me permission check on /convert.
JWT_SECRET=
BACKEND_URL=http://localhost:4300
