# Local dev defaults — matches backend/twin-bridge/blender-bridge's own
# default ports. Copy to .env (gitignored) to override: `cp .env.example .env`.
# Phase 5 will point these at real deployed addresses (a load balancer DNS
# name for backend/blender-bridge, an EC2 endpoint for twin-bridge).
VITE_BACKEND_URL=http://localhost:4300
VITE_TWIN_BRIDGE_URL=http://localhost:4100
VITE_BLENDER_BRIDGE_URL=http://localhost:4200
