# Local dev defaults — matches backend/factory-runtime/blender-bridge's own
# default ports. Copy to .env (gitignored) to override: `cp .env.example .env`.
# Real deployed addresses get set at actual deploy time (a load balancer DNS
# name for backend/blender-bridge, an EC2 endpoint for Factory Runtime).
# VITE_TWIN_BRIDGE_URL name kept as-is post-migration (Factory Runtime
# supersedes twin-bridge, same var name/shape — FACTORY-RUNTIME-MIGRATION-
# PLAN.md §9 decision #4).
VITE_BACKEND_URL=http://localhost:4300
VITE_TWIN_BRIDGE_URL=http://localhost:4103
VITE_BLENDER_BRIDGE_URL=http://localhost:4200
