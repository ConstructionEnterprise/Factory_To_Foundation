# Real auth — must be the exact same real value as backend/.env's and
# twin-bridge/.env's own JWT_SECRET, so this runtime can verify the same
# session cookie the backend issues. BACKEND_URL is where this runtime asks
# for the real /auth/me permission check on the state-changing endpoints
# (/twin-control/start, /twin-control/stop, /twin-command) once in ACTIVE
# mode — unused for permission purposes in passive mode, since those routes
# are refused outright before the permission check runs.
# Copy to .env (gitignored) and fill in the real value: `cp .env.example .env`.
JWT_SECRET=
BACKEND_URL=http://localhost:4300

# CORS origin this runtime allows — matches the frontend dev server.
ALLOWED_ORIGIN=http://localhost:5173

# "passive" (default if unset) = read-only validation/compatibility
# instance, never spawns or claims authority over the Twin. "active" = the
# real Factory Runtime, owns the driver end to end. Do not set this to
# "active" outside a deliberate cutover (FACTORY-RUNTIME-MIGRATION-PLAN.md
# §7 step 4) while twin-bridge is still running as the real owner — two
# processes both spawning the driver corrupts state.json (confirmed live,
# same failure mode as the 2026-08-11 CE validation-gate incident).
FACTORY_RUNTIME_MODE=passive

# Own port, distinct from twin-bridge's 4100.
FACTORY_RUNTIME_PORT=4103
